{
  "protocolVersion": 1,
  "request": {"version": 1, "requestId": "unique-active-request-id", "command": {"operation": "info"}},
  "response": {"version": 1, "requestId": "unique-active-request-id", "data": {}},
  "errorSchema": {"schema_version": 1, "fields": ["schema_version", "code", "message", "details"], "busyCode": "TDB_BUSY", "reentrantCode": "TDB_REENTRANT_ACCESS", "poisonedHostCode": "TDB_HOST_LOCK_POISONED"},
  "idEncoding": "decimal-string",
  "binaryVectorComponentEncoding": "decimal-string",
  "operations": {
    "info": [],
    "query": ["query", "parameters?"],
    "mutate": ["query"],
    "getNodes": ["ids", "withRevision?"],
    "search": ["vector", "topK", "expandDepth?", "minScore?"],
    "subgraph": ["source", "depth?", "labels?", "maxNodes?"],
    "edges": ["node", "incoming?"],
    "path": ["source", "target", "maxDepth", "label?"],
    "indexes": [],
    "manageIndex": ["kind", "fields", "create"],
    "buildQuiver": [],
    "transaction": ["operations"],
    "guardedTransaction": ["expectedRevision", "idempotencyKey", "operations"],
    "transactionStatus": ["expectedRevision", "idempotencyKey", "operations"],
    "importNodes": ["records"],
    "importEdges": ["records"]
  },
  "transactionOperations": ["insert", "updatePayload", "updateVector", "delete", "link", "unlink"],
  "writeOperations": ["mutate", "manageIndex", "buildQuiver", "transaction", "guardedTransaction", "importNodes", "importEdges"],
  "completion": {
    "cancelAcknowledgement": "signal-issued",
    "detachAcknowledgement": "admission-closed",
    "drainedCondition": "detached-and-no-active-core-requests",
    "httpStatusPath": "/v1/console/status",
    "httpIdentityHeader": "x-tdb-request-id",
    "httpIdentityEncoding": "ascii-json-string",
    "httpIdentityMustMatchBody": true,
    "transportWriteFailure": {"phase":"response","outcome":"unknown"},
    "bridgeContextFields": ["requestId", "operation", "write", "signal"],
    "hostDrainPendingCode": "TDB_BUSY",
    "hostDrainResource": "console_bridge_drain"
  },
  "editing": {
    "revisionScope": "database-instance",
    "snapshotOperation": "getNodes",
    "snapshotOption": "withRevision",
    "guardedOperation": "guardedTransaction",
    "legacyWritesRemainUnconditional": true,
    "maxReceipts": 64,
    "maxReceiptBytes": 8388608,
    "receiptPersistence": "wal-checkpoint",
    "receiptMissMeans": "unknown",
    "requestIdIsIdempotencyKey": false,
    "replayIdentity": ["idempotencyKey", "expectedRevision", "operations"]
  },
  "unsupported": ["open-path", "close-database", "interactive-transaction", "per-node-occ", "unbounded-idempotency", "ndjson-streaming"],
  "frontend": {"legacyHtmlTransport": "server-http-v1", "embeddedTransport": "console-rpc-v1", "requiresTransportAdapter": false, "mountEntry": "console-embed.js", "clientEntry": "console-client.js", "isolation": "same-origin-iframe", "storageIdentity": "host-provided"},
  "documentation": "docs/embedded-console.md"
}
