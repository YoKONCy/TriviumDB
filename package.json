{
  "name": "triviumdb",
  "version": "0.9.0-beta.4",
  "description": "AI-native embedded database: Vector + Graph + Relational in one file",
  "main": "index.js",
  "types": "triviumdb.d.ts",
  "files": [
    "*.node",
    "index.js",
    "triviumdb.d.ts"
  ],
  "napi": {
    "binaryName": "triviumdb"
  },
  "scripts": {
    "build": "napi build --platform --no-js --release --features nodejs",
    "build:debug": "napi build --platform --no-js --features nodejs",
    "test:lifecycle": "node tests/node/lifecycle.js",
    "test:resource-lifecycle": "node --expose-gc tests/node/resource_lifecycle.js",
    "test:process-lifecycle": "node --expose-gc tests/node/process_lifecycle.js",
    "test:public-api": "node tests/node/public_api.js",
    "test:types": "tsc --project tests/node/types/tsconfig.json",
    "test:package": "node scripts/check_node_package.cjs",
    "prepublishOnly": "napi build --platform --no-js --release --features nodejs"
  },
  "keywords": [
    "database",
    "vector",
    "graph",
    "embedding",
    "ai",
    "sqlite",
    "rust"
  ],
  "author": "YoKONCy",
  "license": "Apache-2.0",
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YoKONCy/TriviumDB"
  }
}
